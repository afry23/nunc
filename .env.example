# OAuth-Zugangsdaten für Google Drive und Todoist (nur Entwicklung).
# Kopieren nach .env (steht in .gitignore) und ausfüllen. Debug-Builds lesen die Datei im aktuellen Ordner oder
# darüber; Umgebungsvariablen haben Vorrang. Die Namen der Go-App (GOOGLE_CLIENT_ID, …) gehen ebenfalls, die
# .env von ../nunc-go lässt sich also direkt kopieren.
# Release-Builds lesen keine .env: dort NUNC_* beim Bauen setzen.
NUNC_GOOGLE_CLIENT_ID=
NUNC_GOOGLE_CLIENT_SECRET=
NUNC_TODOIST_CLIENT_ID=
NUNC_TODOIST_CLIENT_SECRET=
