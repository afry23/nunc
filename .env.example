# Fester Google-OAuth-Client nur für die Entwicklung (ADR 0019).
# Kopieren nach .env (steht in .gitignore) und ausfüllen. Debug-Builds lesen die Datei im aktuellen Ordner oder
# darüber; Umgebungsvariablen haben Vorrang. Ein hier gesetzter Client hat Vorrang vor dem in der App eingetragenen.
# Release-Builds lesen keine .env und bauen keinen Client ein: Nutzer tragen ihren eigenen in den Einstellungen ein.
# Todoist braucht keinen Client mehr (persönliches API-Token, ADR 0020).
NUNC_GOOGLE_CLIENT_ID=
NUNC_GOOGLE_CLIENT_SECRET=
